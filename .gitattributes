# Normalize all text files to LF line endings in the repository.
# This prevents every line from showing as "changed" when contributors
# on Windows (CRLF) and macOS/Linux (LF) work on the same files.
* text=auto eol=lf

# Binary files - never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
